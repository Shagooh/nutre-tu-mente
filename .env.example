# Copia este archivo como ".env" y pega los valores de tu proyecto Firebase
# (Firebase Console -> Configuración del proyecto -> Tus apps -> App web -> SDK de configuración).
# Estos valores NO son secretos: identifican el proyecto. La seguridad está en firestore.rules.
# Si los dejas vacíos, la app funciona solo en modo local (sin cuentas ni nube).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
